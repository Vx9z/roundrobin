<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/feed.css">
</head>
<body>
<div class="feed-container">
  {{> navbar}}

  <h2>Bookmarked Posts</h2>

  <p class="refresh-link"><a href="/bookmarks">↻ Refresh</a></p>

  <div class="post-list">
    {{#if posts.length}}
      {{#each posts}}{{> post this returnTo=../returnTo}}{{/each}}
    {{else}}
      <p>You haven't bookmarked any posts yet.</p>
    {{/if}}
  </div>
</div>

</body>
</html>
