<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/community.css">
</head>
<body>
<div class="community-container">
  {{> navbar}}

  <h2>Communities</h2>

  <p><a href="/communities/new" class="btn-create-community">+ Create a community</a></p>

  {{#if myCommunities.length}}
    <h3>My communities</h3>
    <ul>
      {{#each myCommunities}}
        <li><a href="/communities/{{communityID}}">{{name}}</a></li>
      {{/each}}
    </ul>
  {{/if}}

  <h3>All communities</h3>
  <div class="community-list">
    {{#if communities.length}}
      {{#each communities}}
        <div class="community-row">
          <div class="community-info">
            <a href="/communities/{{communityID}}" class="community-name">{{name}}</a>
            <p class="community-description">{{description}}</p>
            <span class="community-meta">{{memberCount}} members</span>
          </div>
          <div class="community-action">
            {{#if isBanned}}
              <span class="banned-label">Banned</span>
            {{else if isMember}}
              <span class="member-label">Member</span>
            {{else}}
              <form action="/communities/{{communityID}}/join" method="post" class="inline-form">
                <button type="submit">Join</button>
              </form>
            {{/if}}
          </div>
        </div>
      {{/each}}
    {{else}}
      <p>No communities yet. Be the first to create one!</p>
    {{/if}}
  </div>
</div>

</body>
</html>
