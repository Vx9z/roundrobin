<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/feed.css">
  <link rel="stylesheet" href="/css/community.css">
</head>
<body>
<div class="feed-container">
  {{> navbar}}

  {{#if bannerURL}}
    <img src="{{bannerURL}}" class="community-banner">
  {{/if}}

  <h2>{{name}}</h2>
  {{#if description}}<p class="community-description">{{description}}</p>{{/if}}
  <p class="community-meta">{{memberCount}} members</p>

  <p class="community-actions">
    {{#if isBanned}}
      <span class="banned-label">You are banned from this community</span>
    {{else if isMember}}
      <form action="/communities/{{communityID}}/leave" method="post" class="inline-form">
        <button type="submit">Leave</button>
      </form>
    {{else}}
      <form action="/communities/{{communityID}}/join" method="post" class="inline-form">
        <button type="submit">Join</button>
      </form>
    {{/if}}
    {{#if isMod}}
      <a href="/communities/{{communityID}}/dashboard" class="mod-dashboard-link">Moderator dashboard</a>
    {{/if}}
    {{#if isReportedByMe}}
      <button type="button" class="btn-reported" disabled>⚑ Reported</button>
    {{else}}
      <form action="/communities/{{communityID}}/report" method="post" class="inline-form">
        <button type="submit" class="btn-report">⚑ Report community</button>
      </form>
    {{/if}}
  </p>

  <p class="refresh-link"><a href="/communities/{{communityID}}">↻ Refresh</a></p>

  {{#if isMember}}
    <form action="/posts" method="post" enctype="multipart/form-data"
          class="mb-5 rounded-xl border border-base-content/10 bg-base-200 p-4">
      <input type="hidden" name="communityID" value="{{communityID}}">
      <textarea name="content" placeholder="Post to {{name}}..." class="d-textarea w-full"></textarea>
      <div class="mt-2 flex items-center gap-2">
        <input type="file" name="media" class="d-file-input d-file-input-sm">
        <button type="button" class="d-btn d-btn-sm d-btn-ghost" data-code-toggle="#compose-code-panel">&lt;/&gt; Code</button>
        <button type="submit" class="d-btn d-btn-sm d-btn-primary ml-auto">Post</button>
      </div>
      <div id="compose-code-panel" class="hidden mt-3 rounded-lg border border-base-content/10 bg-base-100 p-3">
        <select name="codeLanguage" class="d-select d-select-sm">
          {{#each codeLanguages}}<option value="{{this.id}}">{{this.label}}</option>{{/each}}
        </select>
        <textarea name="codeContent" placeholder="Paste code here..." rows="6"
                  class="d-textarea mt-2 w-full font-mono text-sm"></textarea>
      </div>
    </form>
  {{/if}}

  <div class="post-list">
    {{#if posts.length}}
      {{#each posts}}{{> post this returnTo=../returnTo}}{{/each}}
    {{else}}
      <p>No posts yet in this community.</p>
    {{/if}}
  </div>
</div>

<script src="/js/compose-code-toggle.js"></script>
<script src="/js/code-copy.js"></script>
<script src="/js/post-actions.js"></script>
</body>
</html>
