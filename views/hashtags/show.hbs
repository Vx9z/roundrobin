<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/feed.css">
</head>
<body>
<div class="feed-layout">
  <div class="feed-container">
    {{> navbar}}

    <h2>#{{tag}}</h2>
    <p class="refresh-link"><a href="/hashtags/{{tag}}">↻ Refresh</a></p>

    <div class="post-list">
      {{#if posts.length}}
        {{#each posts}}{{> post this returnTo=../returnTo}}{{/each}}
      {{else}}
        <p>No posts use #{{tag}} yet.</p>
      {{/if}}
    </div>
  </div>

  {{> trending}}
</div>

</body>
</html>
