<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
<div class="dashboard-container">
  {{> navbar}}

  <h2>Platform Moderation</h2>

  <h3>Reported posts</h3>
  {{#if reportedPosts.length}}
    <table>
      <tr><th>Post</th><th>Author</th><th>Community</th><th>Reports</th><th>First reported</th><th>Actions</th></tr>
      {{#each reportedPosts}}
        <tr>
          <td>{{preview}}{{#if hasMedia}} <em>[media]</em>{{/if}}</td>
          <td><a href="/profile/{{authorID}}">{{authorUsername}}</a></td>
          <td>{{#if inCommunity}}<a href="/communities/{{communityID}}">{{communityName}}</a>{{else}}—{{/if}}</td>
          <td>{{reportCount}}</td>
          <td>{{firstReportedAtDisplay}}</td>
          <td>
            <form action="/posts/{{postID}}/report/dismiss" method="post" class="inline-form">
              <input type="hidden" name="returnTo" value="/admin/dashboard">
              <button type="submit">Dismiss</button>
            </form>
            {{#if inCommunity}}
              <form action="/communities/{{communityID}}/posts/{{postID}}/delete" method="post" class="inline-form">
                <button type="submit" class="btn-delete-post">Remove post</button>
              </form>
            {{else}}
              <form action="/admin/posts/{{postID}}/delete" method="post" class="inline-form">
                <button type="submit" class="btn-delete-post">Remove post</button>
              </form>
            {{/if}}
          </td>
        </tr>
      {{/each}}
    </table>
  {{else}}
    <p>No reported posts.</p>
  {{/if}}

  <h3>Reported users</h3>
  {{#if reportedUsers.length}}
    <table>
      <tr><th>User</th><th>Status</th><th>Reports</th><th>First reported</th><th>Actions</th></tr>
      {{#each reportedUsers}}
        <tr>
          <td><a href="/profile/{{userID}}">{{username}}</a></td>
          <td>{{#if isSuspended}}SUSPENDED{{else}}active{{/if}}</td>
          <td>{{reportCount}}</td>
          <td>{{firstReportedAtDisplay}}</td>
          <td>
            <form action="/admin/reports/users/{{userID}}/dismiss" method="post" class="inline-form">
              <button type="submit">Dismiss</button>
            </form>
            {{#unless isSuspended}}
              <form action="/admin/users/{{userID}}/suspend" method="post" class="inline-form">
                <button type="submit" class="btn-delete-post">Suspend</button>
              </form>
            {{/unless}}
          </td>
        </tr>
      {{/each}}
    </table>
  {{else}}
    <p>No reported users.</p>
  {{/if}}

  <h3>Reported communities</h3>
  {{#if reportedCommunities.length}}
    <table>
      <tr><th>Community</th><th>Members</th><th>Reports</th><th>First reported</th><th>Actions</th></tr>
      {{#each reportedCommunities}}
        <tr>
          <td><a href="/communities/{{communityID}}">{{name}}</a></td>
          <td>{{memberCount}}</td>
          <td>{{reportCount}}</td>
          <td>{{firstReportedAtDisplay}}</td>
          <td>
            <a href="/communities/{{communityID}}/dashboard">Manage</a>
            <form action="/admin/reports/communities/{{communityID}}/dismiss" method="post" class="inline-form">
              <button type="submit">Dismiss</button>
            </form>
          </td>
        </tr>
      {{/each}}
    </table>
  {{else}}
    <p>No reported communities.</p>
  {{/if}}

  <h3>Users</h3>
  <table>
    <tr><th>User</th><th>Clearance</th><th>Status</th><th>Analytics</th><th>Actions</th></tr>
    {{#each users}}
      <tr>
        <td><a href="/profile/{{userID}}">{{username}}</a></td>
        <td>{{clearanceLevel}}</td>
        <td>{{#if isSuspended}}SUSPENDED{{else}}active{{/if}}</td>
        <td><a href="/admin/users/{{userID}}">View</a></td>
        <td>
          {{#unless isSelf}}
            {{#if isSuspended}}
              <form action="/admin/users/{{userID}}/unsuspend" method="post" class="inline-form">
                <button type="submit">Unsuspend</button>
              </form>
            {{else}}
              <form action="/admin/users/{{userID}}/suspend" method="post" class="inline-form">
                <button type="submit" class="btn-delete-post">Suspend</button>
              </form>
            {{/if}}
          {{/unless}}
        </td>
      </tr>
    {{/each}}
  </table>

  <h3>Communities</h3>
  <table>
    <tr><th>Community</th><th>Members</th><th>Manage</th><th>Delete</th></tr>
    {{#each communities}}
      <tr>
        <td><a href="/communities/{{communityID}}">{{name}}</a></td>
        <td>{{memberCount}}</td>
        <td><a href="/communities/{{communityID}}/dashboard">Manage</a></td>
        <td>
          <form action="/communities/{{communityID}}/delete" method="post" class="inline-form">
            <input type="text" name="confirmName" placeholder='Type "{{name}}" to confirm' required>
            <button type="submit" class="btn-delete-post">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </table>
</div>

</body>
</html>
