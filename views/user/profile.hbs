<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/feed.css">
</head>
<body>
{{> navbar}}

{{!-- No per-owner data-theme here: profile cards render in the VIEWER's
      site-wide theme (from <html data-theme> in the layout), same as every
      other page, so the look stays consistent no matter whose profile you're
      on. --}}
<div class="relative isolate min-h-screen text-left">

  {{#if backgroundURL}}
    {{!-- Rendered as an <img>, not a CSS background-image: the URL is
          user-controlled and Handlebars does not escape ")" or ";", so
          interpolating it into url() would be a CSS-injection vector. --}}
    <img src="{{backgroundURL}}" alt=""
         class="pointer-events-none fixed inset-0 z-0 h-full w-full object-cover">
    {{!-- Scrim: the image stays sharp behind the gaps, but text never sits on
          raw photo. Gradient rather than flat so the top edge stays vivid. --}}
    <div class="pointer-events-none fixed inset-0 z-0
                bg-gradient-to-b from-base-100/40 via-base-100/65 to-base-100/90"></div>
  {{/if}}

  <div class="relative z-10 mx-auto max-w-3xl px-4 py-10">

    {{#if profileOwner}}
      <p class="mb-4"><a href="/feed" class="d-btn d-btn-sm d-btn-ghost no-underline">&larr; Back</a></p>
    {{/if}}

    <div class="overflow-hidden rounded-2xl border border-base-content/10 bg-base-100/60
                shadow-2xl backdrop-blur-xl backdrop-saturate-150 text-base-content">
      {{#if bannerURL}}
        <img src="{{bannerURL}}" alt="" class="h-40 w-full object-cover">
      {{/if}}

      <div class="p-6">
        <img src="{{avatarURL}}" alt="" class="avatar">

        <h2 class="text-2xl font-bold">Welcome, {{username}}</h2>
        <p class="opacity-70">Email: {{email}}</p>
        <p class="opacity-70">Clearance Level: {{clearanceLevel}}</p>

        {{#if bio}}
          <p class="bio mt-3">{{bio}}</p>
        {{/if}}

        <div class="mt-4">
        {{#if profileOwner}}
          <p><a href="/profile/{{userID}}/edit" class="d-btn d-btn-sm d-btn-outline">Edit Profile</a></p>

          <h3 class="mt-4 font-semibold">Friends</h3>
          <ul>
            {{#each friendsList}}
              <li><a href="/profile/{{this.userID}}" class="d-link d-link-hover">{{this.username}}</a></li>
            {{/each}}
          </ul>
        {{else}}
          <div class="flex flex-wrap items-center gap-2">
          {{#if isBlocked}}
            <p>You are blocked from viewing this profile.</p>
          {{else}}
            {{#if isFollowing}}
              <form action="/profile/{{userID}}/unfollow" method="post" class="inline-form">
                <button type="submit" class="d-btn d-btn-sm d-btn-ghost">Unfollow</button>
              </form>
            {{else}}
              <form action="/profile/{{userID}}/follow" method="post" class="inline-form">
                <button type="submit" class="d-btn d-btn-sm d-btn-primary">Follow</button>
              </form>
            {{/if}}
            <form action="/profile/{{userID}}/block" method="post" class="inline-form">
              <button type="submit" class="d-btn d-btn-sm d-btn-error d-btn-outline">Block</button>
            </form>
          {{/if}}
          {{#if isReportedByMe}}
            <button type="button" class="d-btn d-btn-sm d-btn-ghost" disabled>⚑ Reported</button>
          {{else}}
            <form action="/profile/{{userID}}/report" method="post" class="inline-form">
              <button type="submit" class="d-btn d-btn-sm d-btn-warning d-btn-outline">⚑ Report user</button>
            </form>
          {{/if}}
          </div>
        {{/if}}
        </div>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-base-content/10 bg-base-100/60 p-6
                shadow-2xl backdrop-blur-xl backdrop-saturate-150 text-base-content">
      <h3 class="mb-3 text-xl font-semibold">Posts</h3>
      <div class="post-list">
        {{#if posts.length}}
          {{#each posts}}{{> post this returnTo=../returnTo}}{{/each}}
        {{else}}
          <p>No posts yet.</p>
        {{/if}}
      </div>
    </div>

    {{#unless profileOwner}}
      <p class="mt-6"><a href="/search" class="back-link">&larr; Back to Search</a></p>
    {{/unless}}
  </div>
</div>
<script src="/js/code-copy.js"></script>
<script src="/js/post-actions.js"></script>
<script src="/vendor/animejs/anime.umd.min.js"></script>
<script src="/js/button-animations.js"></script>
</body>
</html>
