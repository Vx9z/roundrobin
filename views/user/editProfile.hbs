<!DOCTYPE html>
<html>
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
<div class="profile-container">
  {{> navbar}}

  <h2>Edit Profile</h2>
  <form action="/profile/{{userID}}/edit" method="post" enctype="multipart/form-data">
    <label>Username:</label>
    <input type="text" name="username" value="{{username}}" required><br>

    <label>Email:</label>
    <input type="email" name="email" value="{{email}}"><br>

    <label>Bio:</label>
    <textarea name="bio">{{bio}}</textarea><br>

    <label>Profile Picture:</label>
    {{#if avatarURL}}
      <img src="{{avatarURL}}" class="avatar-preview">
    {{/if}}
    <input type="file" name="avatar"><br>

    <label>Banner:</label>
    {{#if bannerURL}}
      <img src="{{bannerURL}}" class="banner-preview">
    {{/if}}
    <input type="file" name="banner"><br>

    <button type="submit" class="btn-edit">Save Changes</button>
  </form>

  <p><a href="/profile/{{userID}}" class="back-link">← Back to Profile</a></p>
</div>

</body>
</html>
